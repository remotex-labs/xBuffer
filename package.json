{
    "name": "@remotex-labs/xbuffer",
    "main": "dist/cjs/index.js",
    "type": "module",
    "types": "./dist/index.d.ts",
    "module": "./dist/esm/index.js",
    "author": "Garefild",
    "version": "v1.0.0-local",
    "license": "Mozilla Public License Version 2.0",
    "homepage": "https://github.com/remotex-lab/xStruct",
    "description": "A library with Node.js Buffer api for the browser",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/remotex-lab/xBuffer.git"
    },
    "bugs": {
        "url": "https://github.com/remotex-lab/xBuffer/issues"
    },
    "keywords": [
        "xbuffer",
        "xBuffer",
        "buffer",
        "Uint8Array",
        "dataview",
        "arraybuffer",
        "browser",
        "compatible"
    ],
    "engines": {
        "node": ">=20"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "dev":              "xBuild -w",
        "build":            "xBuild",
        "build:clean":      "rm -rf ./dist && xBuild",

        "test":             "xjet",
        "test:coverage":    "xjet --coverage",

        "lint":             "pnpm lint:md && pnpm lint:eslint && pnpm lint:typescript",
        "lint:md":          "markdownlint \"**/*.md\" --ignore node_modules",
        "lint:eslint":      "eslint . -c ./eslint.config.mjs",
        "lint:typescript":  "xBuild --tc",

        "docs:dev":         "vitepress dev docs",
        "docs:build":       "vitepress build docs",
        "docs:preview":     "vitepress preview docs",

        "ci":              "pnpm lint && pnpm test && pnpm build:clean",
        "prepublishOnly":  "pnpm lint && pnpm test && pnpm build:clean"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "eslint": "^9.16.0",
        "typescript-eslint": "^8.16.0",
        "eslint-plugin-jsdoc": "^50.6.0",
        "@swc/jest": "^0.2.36",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@remotex-labs/xbuild": "^1.3.6"
    },
    "dependencies": {
    }
}
